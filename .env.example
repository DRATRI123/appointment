# Production settings for `docker compose up -d` (this folder). Create the real file with:
#     python scripts/generate_env.py --domain clinic.example.com
# which fills every secret below with fresh random values. Never commit .env.

# --- your site --------------------------------------------------------------
DOMAIN=clinic.example.com            # DNS A/AAAA record must point at this server; Caddy gets the HTTPS certificate
APP_NAME=Appointment Platform
APP_ENV=production
ENABLE_HSTS=true                     # browsers will insist on HTTPS for 2 years; keep true once HTTPS works

# --- secrets (generate_env.py writes these; keep a copy in your password manager) ---
SECRET_KEY=
DATA_ENCRYPTION_KEY=                 # encrypts clinical notes; losing it makes them unreadable
OTP_PEPPER=
POSTGRES_PASSWORD=
BACKUP_ENCRYPTION_KEY=               # encrypts backups; store it OFF this server or backups are useless after a disaster
METRICS_TOKEN=                       # only needed with the monitoring profile

# --- database (inside the Docker network; never published) ----------------------
POSTGRES_USER=app
POSTGRES_DB=appointments

# --- login codes, email, SMS, WhatsApp (see backend/.env.example for every option) ---
OTP_PROVIDER=msg91                   # console is refused in production
EMAIL_PROVIDER=smtp
SMS_PROVIDER=msg91
WHATSAPP_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
OTP_SMS_TEMPLATE_ID=

# --- backups ----------------------------------------------------------------
BACKUP_AT=02:30                      # daily, in BACKUP_TIMEZONE
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_S3_BUCKET=                    # optional off-site copy (S3, R2, B2, MinIO); uses the S3_* credentials below
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- monitoring (optional) ----------------------------------------------------
SENTRY_DSN=

# --- advanced -----------------------------------------------------------------
DOCKER_SUBNET=172.28.0.0/16          # internal network; the API trusts forwarded client IPs only from here
TAG=latest
WEB_CONCURRENCY=2                    # API worker processes; one per CPU core (see documentation/performance.md)
