# =====================================================================================================================
#  .env.example: EVERY setting, explained. Reference only: do not copy this file directly.
#
#  Pick the template for where the app runs, copy it, and fill it in:
#
#    Where                                 Template                       Copy to          Database
#    ------------------------------------  -----------------------------  ---------------  -------------------------
#    Your Windows PC (START-APP.bat)       .env.development.example       backend\.env     SQLite file
#    Automated tests / CI / compose.test   .env.test.example              (used directly)  throw-away SQLite/Postgres
#    Staging server (test domain)          .env.staging.example           .env (here)      its own PostgreSQL
#    Production server (Hostinger VPS)     .env.production.example        .env (here)      PostgreSQL
#
#  Real .env files are never committed (.gitignore). On servers, deployment/scripts/deploy.sh creates .env from the
#  template with fresh random secrets and refuses to run with example values.
#  The API checks its settings at start and refuses to run with anything unsafe for its environment
#  (docs/environment-configuration.md lists every check).
#
#  [all] every environment   [server] staging + production   [docker] Docker Compose only   [dev] development only
# =====================================================================================================================

# --- Application -----------------------------------------------------------------------------------------------------
APP_NAME=Appointment Platform          # [all] shown in emails, the browser title and authenticator apps
APP_ENV=development                    # [all] development | test | staging | production (decides which checks apply)
APP_VERSION=0.1.0                      # [all] shown on /api/v1/meta
DEBUG=false                            # [dev] extra error detail; must be false on servers
API_V1_PREFIX=/api/v1                  # [all] do not change
LOG_LEVEL=INFO                         # [all] DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                         # [all] true on servers (one JSON line per event; no passwords, codes or tokens)
FRONTEND_URL=http://localhost:3000     # [all] public address of the website; https:// on servers (links in messages)

# --- Secrets (servers: random values, generated by deploy.sh; keep a copy OFF the server) ---------------------------
SECRET_KEY=                            # [all] signs sign-in tokens. Server: 48+ random characters
DATA_ENCRYPTION_KEY=                   # [server] base64 of 32 random bytes: encrypts notes, credentials, MFA secrets
DATA_ENCRYPTION_PREVIOUS_KEYS=         # [server] old keys after a rotation (comma-separated) until rotate_keys is done
OTP_PEPPER=                            # [server] 16+ random characters mixed into one-time-code hashes
BACKUP_ENCRYPTION_KEY=                 # [server] base64 of 32 random bytes: encrypts backups (lose it = backups unreadable)
METRICS_TOKEN=                         # [server] 24+ characters; protects /metrics (empty = /metrics off)
JWT_ALGORITHM=HS256                    # [all] do not change
ACCESS_TOKEN_EXPIRE_MINUTES=15         # [all] how long a sign-in token lives before it is refreshed
REFRESH_TOKEN_EXPIRE_DAYS=30           # [all] how long "stay signed in" lasts (refresh tokens rotate on every use)
SESSION_IDLE_MINUTES=720               # [all] a device not used for this long is signed out (screen lock: clinic privacy settings)

# --- Super admin protection -------------------------------------------------------------------------------------------
PLATFORM_ADMIN_REQUIRE_MFA=true        # [all] super admins must use two-step sign-in (servers refuse false)
PLATFORM_ADMIN_ALLOWED_IPS=            # [server] optional: super admin pages only from these IPs/ranges, e.g. 203.0.113.7

# --- HTTPS, cookies, browsers ------------------------------------------------------------------------------------------
COOKIE_SECURE=false                    # [all] true on servers: cookies only over HTTPS (also sends HSTS)
COOKIE_DOMAIN=                         # [server] usually empty (the site's own host)
CORS_ORIGINS=http://localhost:3000     # [all] browser origins allowed to call the API directly (https:// on servers)
TRUSTED_HOSTS=*                        # [server] host names the API answers for, e.g. book.yourclinic.in (never * there)
FORWARDED_ALLOW_IPS=127.0.0.1,::1      # [all] only these proxies may tell the API the visitor's IP (never *)
ENABLE_HSTS=false                      # [docker] true once HTTPS works: browsers then insist on HTTPS for 2 years

# --- Abuse protection --------------------------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true                # [all] must be true on servers
RATE_LIMIT_DEFAULT=120/minute          # [all] default per-IP limit for API routes without their own
API_KEY_DEFAULT_RATE_LIMIT=120         # [all] requests per minute per developer API key
MAX_UPLOAD_SIZE_MB=5                   # [all] largest image/document upload
UPLOAD_SCANNER=none                    # [server] none | clamav: scan every upload for viruses (refuses uploads if clamd is down)
CLAMAV_HOST=clamav                     # [server] clamd address (compose profile "antivirus" runs one)
CLAMAV_PORT=3310
OTP_EXPIRE_SECONDS=300                 # [all] sign-in code lifetime
OTP_RESEND_COOLDOWN_SECONDS=60         # [all] wait before another sign-in code
OTP_MAX_ATTEMPTS=5                     # [all] wrong sign-in codes before the code is locked
OTP_LENGTH=6                           # [all] digits in a sign-in code
OTP_TEST_CODE=                         # [dev] load tests only: every booking code = this value (refused on servers)

# --- Database -----------------------------------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db   # [all] SQLite file on a PC; postgresql+psycopg://user:pass@host:5432/db on servers
DATABASE_ECHO=false                    # [dev] print every SQL statement
DATABASE_POOL_SIZE=10                  # [all] open connections kept per API process
DATABASE_MAX_OVERFLOW=20               # [all] extra connections under load
DATABASE_POOL_TIMEOUT_SECONDS=10       # [all] wait this long for a free connection, then fail fast
DATABASE_STATEMENT_TIMEOUT_MS=30000    # [server] PostgreSQL: cancel any statement running longer
DATABASE_SLOW_QUERY_MS=500             # [all] log statements slower than this (text only, never the values)
DEV_ALLOW_REMOTE_DATABASE=false        # [dev] allow a database on another machine (never a production one)
POSTGRES_USER=app                      # [docker] PostgreSQL container user
POSTGRES_PASSWORD=                     # [docker] PostgreSQL container password (random, generated)
POSTGRES_DB=appointments               # [docker] PostgreSQL database name
REDIS_URL=                             # [server] redis://redis:6379/0 shares rate limits between API processes
JOB_BACKEND=inline                     # [all] background jobs run in the worker process (python -m app.workers.runner)
WORKER_THREADS=0                       # [all] request threads per API process: 8 for one process, 0 (=40) for several
WEB_CONCURRENCY=2                      # [docker] API processes per container (about one per CPU core)
PUBLIC_CACHE_SECONDS=5                 # [all] seconds the public clinic/doctor/service lists are cached per process

# --- Files ---------------------------------------------------------------------------------------------------------------
STORAGE_BACKEND=local                  # [all] local | s3
STORAGE_LOCAL_PATH=./uploads           # [all] folder for uploads (Docker: /data/uploads volume)
S3_BUCKET=                             # [server] when STORAGE_BACKEND=s3 (any S3-compatible service)
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# --- Booking rules (clinics can change their own in the admin) ---------------------------------------------------------
BOOKING_HOLD_MINUTES=10                # [all] how long a chosen time is held while the patient finishes
PAYMENT_WINDOW_MINUTES=30              # [all] unpaid advance bookings are released after this

# --- Messages: one-time codes, email, SMS, WhatsApp ---------------------------------------------------------------------
# console  = printed to the log, nothing sent (development and tests only; refused on servers)
# disabled = the platform has no account for that channel (clinics can still add their own in the admin)
OTP_PROVIDER=console                   # [all] sign-in codes: console | notifications (sent through the SMS/email providers below)
# Every message and integration setting below can instead be saved in Super admin -> Integrations (the panel value wins).
EMAIL_PROVIDER=console                 # [all] console | smtp | brevo | ses | disabled
SMS_PROVIDER=console                   # [all] console | msg91 | twilio | twofactor | sns | disabled
WHATSAPP_PROVIDER=console              # [all] console | meta | twilio | disabled
DEV_ALLOW_REAL_MESSAGES=false          # [dev] allow real providers on a development PC (on purpose only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls                 # starttls | ssl | none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_TIMEOUT_SECONDS=20
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=4
OTP_SMS_TEMPLATE_ID=                   # DLT-approved template for one-time codes (India)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
WHATSAPP_CLOUD_TOKEN=                  # Meta WhatsApp Business Cloud API
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v21.0
OTP_WHATSAPP_TEMPLATE=                 # approved template, e.g. booking_otp:en
EMAIL_FROM=                            # sender email for Brevo / Amazon SES (SMTP uses SMTP_FROM)
EMAIL_FALLBACK_PROVIDER=               # optional: tried once when the main email provider fails (smtp | brevo | ses)
SMS_FALLBACK_PROVIDER=                 # optional: tried once when the main SMS provider fails
BREVO_API_KEY=                         # Brevo transactional email API key (not the SMTP key)
AWS_REGION=                            # Amazon SES (email) and SNS (SMS), e.g. ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TWOFACTOR_API_KEY=                     # 2Factor.in, used for sign-in codes only
TWOFACTOR_SENDER_ID=
SNS_SENDER_ID=                         # DLT header for Amazon SNS (India)
DLT_ENTITY_ID=                         # India DLT principal entity ID (SNS)
WHATSAPP_BUSINESS_ACCOUNT_ID=          # to list your approved WhatsApp templates
WHATSAPP_APP_SECRET=                   # Meta app secret: checks delivery/read reports sent to /api/v1/webhooks/whatsapp
WHATSAPP_WEBHOOK_VERIFY_TOKEN=         # any long random text; the same value goes into Meta's webhook settings
NOTIFICATION_MAX_ATTEMPTS=5            # [all] tries per message before it is marked failed
NOTIFICATION_HTTP_TIMEOUT_SECONDS=15

# --- Integrations -------------------------------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=                      # [all] "Sign in with Google" and Google Calendar (optional)
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_REDIRECT_URI=
CALENDAR_SYNC_DAYS_AHEAD=60
INTEGRATION_HTTP_TIMEOUT_SECONDS=15
WEBHOOK_ALLOW_PRIVATE_TARGETS=         # [dev] allow webhooks to private addresses (refused on servers)
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=8

# --- Monitoring -----------------------------------------------------------------------------------------------------------
SENTRY_DSN=                            # [server] optional error tracking
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Backups --------------------------------------------------------------------------------------------------------------
BACKUP_DIR=                            # [all] default: next to the uploads folder (Docker: /data/backups volume)
BACKUP_AT=02:30                        # [server] daily, in BACKUP_TIMEZONE
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_S3_BUCKET=                      # [server] optional off-site copy (uses the S3_* credentials above)
BACKUP_S3_PREFIX=backups/

# --- Docker deployment (deployment/scripts) --------------------------------------------------------------------------------
DOMAIN=                                # [docker] e.g. book.yourclinic.in (DNS A record must point at the server)
LETSENCRYPT_EMAIL=                     # [docker] for HTTPS certificate expiry notices
TAG=latest                             # [docker] image version label (deploy.sh sets it to the git commit)
DOCKER_SUBNET=172.28.0.0/16            # [docker] internal network; the API trusts forwarded IPs only from here
COMPOSE_FILE=compose.yaml:compose.production.yaml  # [docker] servers: plain `docker compose` uses the production stack
COMPOSE_PROJECT_NAME=appointment       # [docker] appointment (production) | appointment-staging
API_MEMORY=1536m                       # [docker] container limits (2 vCPU / 8 GB VPS defaults); also API_CPUS, WEB_MEMORY,
POSTGRES_MEMORY=2g                     # [docker]   WEB_CPUS, WORKER_MEMORY, WORKER_CPUS, POSTGRES_CPUS, BACKUP_MEMORY
INSTALL_PG_CLIENT=true                 # [docker] build only: false skips pg_dump (test builds without Debian mirrors)
OS_UPGRADE=true                        # [docker] build only: apply OS security updates while building the website image

# --- Frontend (Next.js; read from the environment, no .env needed for local development) -----------------------------------
API_INTERNAL_URL=http://127.0.0.1:8000 # [all] where the website server reaches the API (Docker: http://api:8000)
NEXT_PUBLIC_API_URL=                   # [all] empty = same-origin /api proxy (recommended). Never a secret
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_APP_NAME=Appointment Platform
NEXT_PUBLIC_SITE_URL=                  # [server] public https:// address for links and search engines
