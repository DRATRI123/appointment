# =====================================================================================================================
#  PRODUCTION: the live server (e.g. Hostinger VPS, Ubuntu 24.04, Docker Compose, Nginx, HTTPS, PostgreSQL).
#  Do not fill this in by hand on your PC. On the server run:   ./deployment/scripts/deploy.sh
#  It creates .env from this template with fresh random secrets, asks for the domain, and refuses to deploy while
#  anything is missing or still an example value. Every setting is explained in .env.example.
#
#  After the first deploy, copy DATA_ENCRYPTION_KEY and BACKUP_ENCRYPTION_KEY into your password manager: without them
#  encrypted data and backups cannot be read. Never commit the real .env.
# =====================================================================================================================
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

DOMAIN=
LETSENCRYPT_EMAIL=
ENABLE_HSTS=true

# Filled by deploy.sh with random values.
SECRET_KEY=
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_PREVIOUS_KEYS=
OTP_PEPPER=
BACKUP_ENCRYPTION_KEY=
METRICS_TOKEN=
POSTGRES_PASSWORD=
POSTGRES_USER=app
POSTGRES_DB=appointments

# Real providers. "disabled" = the platform has no account for that channel (clinics can add their own in the admin).
OTP_PROVIDER=notifications
EMAIL_PROVIDER=smtp
SMS_PROVIDER=msg91
WHATSAPP_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
OTP_SMS_TEMPLATE_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
OTP_WHATSAPP_TEMPLATE=

# Super admin: two-step sign-in is always required here. Optional: only from your office IP.
PLATFORM_ADMIN_REQUIRE_MFA=true
PLATFORM_ADMIN_ALLOWED_IPS=

RATE_LIMIT_ENABLED=true
WEB_CONCURRENCY=2
WORKER_THREADS=0

BACKUP_AT=02:30
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SENTRY_DSN=
TAG=latest
DOCKER_SUBNET=172.28.0.0/16
