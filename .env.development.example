# =====================================================================================================================
#  DEVELOPMENT: your Windows PC (or any laptop). No secrets in this file; safe to commit.
#  START-APP.bat copies it to backend\.env the first time. To do it by hand:  copy .env.development.example backend\.env
#  Every setting is explained in .env.example.
#
#  What this gives you: SQLite file database, plain http://localhost, messages and one-time codes PRINTED in the API
#  window (never sent), debug-friendly logs, no real patient data. The API refuses to start if real SMS/email/WhatsApp
#  providers or a database on another machine are configured here by mistake (see DEV_ALLOW_* below).
# =====================================================================================================================
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*
FORWARDED_ALLOW_IPS=127.0.0.1,::1
COOKIE_SECURE=false

# Development-only values. Servers refuse to start with these (deploy.sh generates real random secrets there).
SECRET_KEY=dev-only-not-a-secret-change-me-in-production-0000
DATA_ENCRYPTION_KEY=
OTP_PEPPER=

DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=
RATE_LIMIT_ENABLED=true
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads

# Messages and codes are printed, never sent.
OTP_PROVIDER=console
EMAIL_PROVIDER=console
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console

# Super admin: two-step sign-in is required on servers; optional on your own PC.
PLATFORM_ADMIN_REQUIRE_MFA=false

# One API process (uvicorn --reload): 8 threads measured best. Set 0 if you run uvicorn --workers 4.
WORKER_THREADS=8

# Only change these on purpose: real messages from your PC, or a database on another machine (never production's).
DEV_ALLOW_REAL_MESSAGES=false
DEV_ALLOW_REMOTE_DATABASE=false
OTP_TEST_CODE=
