# Bootstrap mode for ${DOMAIN}: used only until the first HTTPS certificate exists. It answers Let's Encrypt's
# challenge and shows a short "being set up" page; deploy.sh restarts Nginx in HTTPS mode as soon as the
# certificate is issued. No application traffic is ever served over plain HTTP.
server {
    listen 8080 default_server;
    server_name _;
    include /etc/nginx/snippets/health.conf;
    include /etc/nginx/snippets/acme.conf;
    location / {
        default_type text/plain;
        return 503 "This site is being set up. Please try again in a few minutes.\n";
    }
}
