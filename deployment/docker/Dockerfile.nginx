# syntax=docker/dockerfile:1.7
# Nginx with this release's configuration baked in (so a rollback also rolls back the proxy settings) and Alpine
# security updates applied at build time. Runs as the unprivileged nginx user (ports 8080/8443 inside).
# Build context: ./deployment/nginx

ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.30.6-alpine3.24
FROM ${NGINX_IMAGE}
ARG OS_UPGRADE=true
USER root
RUN if [ "$OS_UPGRADE" = "true" ]; then apk upgrade --no-cache; fi \
 && rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/nginx.conf
COPY snippets/ /etc/nginx/snippets/
COPY templates/ /etc/nginx/site-templates/
COPY --chmod=0755 entrypoint/15-choose-site.envsh entrypoint/40-reload-certificates.sh /docker-entrypoint.d/
USER 101
EXPOSE 8080 8443
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/nginx-health"]
