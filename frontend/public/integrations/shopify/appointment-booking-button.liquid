{%- comment -%}
  Appointment booking button. No Shopify app needed: it simply links to your booking page (/{clinic}/book).

  Usage (anywhere in a theme file):
    {% render 'appointment-booking-button', booking_url: 'https://booking.mydomain.com', clinic: 'akshar-clinic' %}
    {% render 'appointment-booking-button', booking_url: 'https://booking.mydomain.com', clinic: 'akshar-clinic',
       service: 'consultation', branch: 'navrangpura', doctor: 'dr-meera-joshi', label: 'Book a consultation',
       style: 'outline', new_tab: true %}

  Parameters
    booking_url  required  Your booking site address, e.g. https://booking.mydomain.com (no trailing slash needed)
    clinic       required  Your clinic's web address name (slug), e.g. akshar-clinic
    service      optional  Preselect a service by its slug, e.g. consultation
    branch       optional  Preselect a location by its slug
    doctor       optional  Preselect a doctor by their slug
    date         optional  Open on a date, YYYY-MM-DD
    source       optional  Campaign source for your website analytics, e.g. shopify (sent as utm_source)
    campaign     optional  Campaign name, e.g. diwali-offer (sent as utm_campaign)
    label        optional  Button text (default "Book appointment")
    style        optional  "solid" (default) or "outline"
    new_tab      optional  true to open the booking page in a new tab

  The URL parameters only preselect choices on the booking page. Prices, availability and payment are always decided
  by the booking system itself, never by this link.
{%- endcomment -%}
{%- liquid
  # Clean every value on its own before joining, so a filter never touches the rest of the address.
  assign ab_base = booking_url | default: '' | strip | split: '?' | first | split: '#' | first
  assign ab_base = ab_base | remove: '"' | remove: "'" | remove: '<' | remove: '>' | remove: ' '
  assign ab_last = ab_base | slice: -1, 1
  if ab_last == '/'
    assign ab_len = ab_base | size | minus: 1
    assign ab_base = ab_base | slice: 0, ab_len
  endif
  assign ab_clinic = clinic | default: '' | handleize
  assign ab_service = service | default: '' | handleize
  assign ab_branch = branch | default: '' | handleize
  assign ab_doctor = doctor | default: '' | handleize
  assign ab_date = date | default: '' | strip | slice: 0, 10 | handleize
  assign ab_source = source | default: '' | handleize
  assign ab_campaign = campaign | default: '' | handleize
  assign ab_query = ''
  if ab_service != ''
    assign ab_query = ab_query | append: '&service=' | append: ab_service
  endif
  if ab_branch != ''
    assign ab_query = ab_query | append: '&branch=' | append: ab_branch
  endif
  if ab_doctor != ''
    assign ab_query = ab_query | append: '&doctor=' | append: ab_doctor
  endif
  if ab_date != ''
    assign ab_query = ab_query | append: '&date=' | append: ab_date
  endif
  if ab_source != ''
    assign ab_query = ab_query | append: '&utm_source=' | append: ab_source
  endif
  if ab_campaign != ''
    assign ab_query = ab_query | append: '&utm_campaign=' | append: ab_campaign
  endif
  if ab_query != ''
    assign ab_query = ab_query | remove_first: '&' | prepend: '?'
  endif
  assign ab_href = ab_base | append: '/' | append: ab_clinic | append: '/book' | append: ab_query
  assign ab_label = label | default: 'Book appointment'
  assign ab_style = style | default: 'solid'
  assign ab_scheme = ab_base | slice: 0, 8
-%}
{%- if ab_scheme == 'https://' and ab_clinic != '' -%}
  <a
    class="ab-button ab-button--{{ ab_style | handleize }}"
    href="{{ ab_href | escape }}"
    {% if new_tab %}target="_blank" rel="noopener"{% endif %}
  >
    <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4"/></svg>
    <span>{{ ab_label | escape }}</span>
  </a>
  <style>
    .ab-button{display:inline-flex;align-items:center;gap:.5rem;padding:.8rem 1.4rem;border-radius:999px;font-weight:600;font-size:1rem;line-height:1.2;text-decoration:none;transition:transform .15s ease,box-shadow .15s ease,background-color .15s ease}
    .ab-button:hover{transform:translateY(-1px);box-shadow:0 6px 16px -6px rgba(0,0,0,.35)}
    .ab-button:focus-visible{outline:3px solid currentColor;outline-offset:3px}
    .ab-button--solid{background:var(--ab-color,#0f5132);color:var(--ab-ink,#fff)}
    .ab-button--outline{background:transparent;color:var(--ab-color,#0f5132);border:2px solid currentColor}
    @media (prefers-reduced-motion:reduce){.ab-button{transition:none}.ab-button:hover{transform:none}}
  </style>
{%- else -%}
  {%- if request.design_mode -%}
    <p style="padding:1rem;border:1px dashed #b91c1c;color:#b91c1c">Booking button: set booking_url (https://…) and clinic.</p>
  {%- endif -%}
{%- endif -%}
