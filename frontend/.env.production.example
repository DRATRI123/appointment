# Production template. Copy to frontend/.env.production on the server (or set these in your hosting panel).
# Only NEXT_PUBLIC_* values reach the browser: never put a secret in one.
# Where the Next.js server reaches the API (private network or localhost behind the reverse proxy).
API_INTERNAL_URL=http://127.0.0.1:8000
# Empty = the browser calls the same https:// origin and Next.js proxies /api (recommended: no CORS, no mixed content).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_APP_NAME=Appointment Platform
