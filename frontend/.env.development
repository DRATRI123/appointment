# Loaded automatically by "npm run dev". No secrets: safe to commit.
# The Next.js server proxies /api/* to the local API, so the browser only ever talks to http://localhost:3000.
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_APP_NAME=Appointment Platform
