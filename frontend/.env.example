# Server-side only: where Next.js proxies /api/* requests (not shipped to the browser).
API_INTERNAL_URL=http://127.0.0.1:8000

# Public values only. Never put secrets in NEXT_PUBLIC_* variables.
# Leave NEXT_PUBLIC_API_URL empty to use the same-origin proxy (recommended).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_APP_NAME=Appointment Platform
