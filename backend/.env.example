# ---- Application ----
APP_NAME=Appointment Platform
APP_ENV=development            # development | test | staging | production
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# ---- Security (generate: python -c "import secrets;print(secrets.token_urlsafe(48))") ----
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=
# Field-level encryption for clinical notes (base64 of 32 random bytes). Required outside development:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
MAX_UPLOAD_SIZE_MB=5

# ---- Database ----
# SQLite for development (relative path resolved from backend/):
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/appointments
DATABASE_ECHO=false

# ---- Redis / jobs ----
REDIS_URL=
JOB_BACKEND=inline            # inline | arq

# ---- Storage ----
STORAGE_BACKEND=local         # local | s3
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Booking defaults ----
BOOKING_HOLD_MINUTES=10
PAYMENT_WINDOW_MINUTES=30

# ---- Providers (adapters) ----
OTP_PROVIDER=console
EMAIL_PROVIDER=console
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
