# Local development on your own computer (Windows, macOS or Linux). No secrets here: safe to commit.
# The dev scripts copy this to backend/.env the first time. Everything runs locally:
# SQLite database, codes and messages printed by "console" providers, no HTTPS.
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# Plain HTTP on localhost. HTTPS, secure cookies and HSTS are switched on in production (.env.production.example).
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*
FORWARDED_ALLOW_IPS=127.0.0.1,::1
COOKIE_SECURE=false

# Development only: a fixed signing key and an encryption key derived from it. Production refuses to start like this.
SECRET_KEY=dev-only-not-a-secret-change-me-in-production-0000
DATA_ENCRYPTION_KEY=
OTP_PEPPER=

# SQLite file next to the code (WAL mode, busy timeout and safe writer locking are set by the app).
DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=

RATE_LIMIT_ENABLED=true

# Request threads per API process. 8 measured best for ONE process (uvicorn --reload, the usual local setup): all
# response-time targets met at 100 users. With several processes (uvicorn --workers 4) leave it empty (default 40).
WORKER_THREADS=8
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads

# Messages and one-time codes are printed to the console, never sent.
OTP_PROVIDER=console
EMAIL_PROVIDER=console
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console

# Load tests only (scripts/perf/load_test.py --otp-code): every booking code becomes this value. Leave empty normally.
OTP_TEST_CODE=
