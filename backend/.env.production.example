# Production template for any hosting provider (VPS, cloud VM, container platform). Copy to backend/.env on the
# server, fill every value, and never commit the filled-in file. The API refuses to start if a required security
# setting is missing or unsafe, and lists every problem at once.
# Generate random values with:  python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- HTTPS ------------------------------------------------------------------------------------------------------
# TLS 1.2/1.3 is terminated by your reverse proxy (Caddy, nginx, a cloud load balancer). The API then:
#   * sends cookies only over HTTPS (COOKIE_SECURE) and adds HSTS,
#   * accepts X-Forwarded-For only from the proxy addresses below (never from anyone else),
#   * accepts requests only for your host names.
FRONTEND_URL=https://booking.example.com
CORS_ORIGINS=https://booking.example.com
TRUSTED_HOSTS=booking.example.com
FORWARDED_ALLOW_IPS=127.0.0.1
COOKIE_SECURE=true
COOKIE_DOMAIN=

# --- secrets (each a fresh random value; keep copies in a password manager, not on this server only) -------------
SECRET_KEY=
DATA_ENCRYPTION_KEY=
# After a key rotation: the previous key(s), comma-separated, until "python -m app.ops.rotate_keys" reports done.
DATA_ENCRYPTION_PREVIOUS_KEYS=
OTP_PEPPER=
BACKUP_ENCRYPTION_KEY=

# --- database ------------------------------------------------------------------------------------------------------
# PostgreSQL is recommended in production (several API processes write in parallel). SQLite also works on one server
# with a local disk; see documentation/performance.md for its limits.
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@127.0.0.1:5432/appointments
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=

# --- storage ---------------------------------------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads

# --- messages and one-time codes (real providers; "console" is refused in production) -------------------------------
OTP_PROVIDER=msg91
EMAIL_PROVIDER=smtp
SMS_PROVIDER=msg91
WHATSAPP_PROVIDER=meta
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
OTP_SMS_TEMPLATE_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

RATE_LIMIT_ENABLED=true
# API processes: start one per CPU core (uvicorn --workers N, or WEB_CONCURRENCY in the Docker image). Leave
# WORKER_THREADS at 0 with several processes (0 = the default of 40 threads each).
WORKER_THREADS=0
SENTRY_DSN=
METRICS_TOKEN=
