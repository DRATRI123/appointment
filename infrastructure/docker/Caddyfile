# Caddy terminates HTTPS (certificates from Let's Encrypt, renewed automatically) and routes:
#   /api/*, /media/*, /docs, /redoc  -> API        everything else -> web app
# /metrics is never routed: Prometheus scrapes it inside the Docker network.
# Caddy replaces any X-Forwarded-For sent by the client with the real peer address, so the API sees true client IPs.
# (Behind Cloudflare or a load balancer, add a global `servers { trusted_proxies static <their ranges> }` block.)

{$DOMAIN} {
	encode zstd gzip
	header -Server

	respond /metrics 404

	@api path /api/* /media/* /docs /docs/* /redoc
	handle @api {
		request_body {
			max_size 12MB
		}
		reverse_proxy api:8000 {
			health_uri /api/v1/health
			transport http {
				keepalive 60s
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			transport http {
				keepalive 60s
			}
		}
	}

	log {
		output stdout
		format json
	}
}
