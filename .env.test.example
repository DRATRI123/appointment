# =====================================================================================================================
#  TEST: automated tests (pytest, Playwright), CI and compose.test.yaml. No secrets, no real data; safe to commit.
#  The API refuses to start in this environment with real SMS/email/WhatsApp providers or a database on another
#  machine. Every setting is explained in .env.example.
# =====================================================================================================================
APP_ENV=test
DEBUG=false
LOG_LEVEL=WARNING
LOG_JSON=false

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*
FORWARDED_ALLOW_IPS=127.0.0.1,::1
COOKIE_SECURE=false

SECRET_KEY=test-only-not-a-secret-0000000000000000000000
DATA_ENCRYPTION_KEY=
OTP_PEPPER=test-pepper-not-secret

# A throw-away database: SQLite for quick runs, or the PostgreSQL service in compose.test.yaml.
DATABASE_URL=sqlite:///./data/test.db
# TEST_DATABASE_URL=postgresql+psycopg://app:test-only@postgres-test:5432/app_test   # PostgreSQL variant of the suite

# Mock providers only: messages land in an in-memory outbox the tests read.
OTP_PROVIDER=console
EMAIL_PROVIDER=console
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console

# Tests register many accounts quickly from one address and create quick super admins.
RATE_LIMIT_ENABLED=false
PLATFORM_ADMIN_REQUIRE_MFA=false
PUBLIC_CACHE_SECONDS=0
