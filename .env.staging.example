# =====================================================================================================================
#  STAGING: a production-like copy on a test domain (e.g. staging.yourclinic.in), on its own server or VPS.
#  Copy to .env in this folder on the STAGING server, or let deployment/scripts/deploy.sh --env staging create it
#  with fresh random secrets. Every setting is explained in .env.example.
#
#  Rules: its own database (never production's), its own secrets (never production's keys), test SMS/email accounts
#  or numbers, no real patients and no real money. UPI here must point at a test UPI ID; staff verification is
#  manual anyway, so no transaction can ever be confirmed automatically.
#  The API applies the same strict checks as production (HTTPS, secrets, no mock providers, super admin MFA).
# =====================================================================================================================
APP_ENV=staging
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

DOMAIN=staging.example.com
LETSENCRYPT_EMAIL=
ENABLE_HSTS=false

# Filled by deploy.sh with random values. Different from production's.
SECRET_KEY=
DATA_ENCRYPTION_KEY=
OTP_PEPPER=
BACKUP_ENCRYPTION_KEY=
METRICS_TOKEN=
POSTGRES_PASSWORD=
POSTGRES_USER=app
POSTGRES_DB=appointments_staging

# Test accounts / numbers only. "disabled" = no platform account for that channel.
OTP_PROVIDER=notifications
EMAIL_PROVIDER=smtp
SMS_PROVIDER=disabled
WHATSAPP_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

PLATFORM_ADMIN_REQUIRE_MFA=true
PLATFORM_ADMIN_ALLOWED_IPS=
RATE_LIMIT_ENABLED=true
WEB_CONCURRENCY=2
BACKUP_AT=03:30
BACKUP_TIMEZONE=Asia/Kolkata
SENTRY_DSN=
TAG=latest
DOCKER_SUBNET=172.29.0.0/16

# --- Docker Compose (read by docker compose itself from this file) ---
COMPOSE_FILE=compose.yaml:compose.production.yaml   # so plain `docker compose ...` always means this server's stack
COMPOSE_PROJECT_NAME=appointment-staging
# Container memory/CPU limits (defaults suit a 2 vCPU / 8 GB VPS):
# API_MEMORY=1536m API_CPUS=1.5 WEB_MEMORY=768m WORKER_MEMORY=512m POSTGRES_MEMORY=2g BACKUP_MEMORY=768m
